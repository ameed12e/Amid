const COUNTRIES = ["United States","United Kingdom","France","Germany","Russia","Ukraine","Canada","Italy","Spain","Netherlands","Australia","Other"];

let lang = 'he';
const flow = ['s-entry','s-rules','s-form','s-review','s-done'];
let idx = 0;

function buildCountries(){
  ['passc','licc'].forEach(id=>{
    const sel = document.getElementById(id);
    sel.innerHTML = COUNTRIES.map(c=>`<option${c==='United States'?' selected':''}>${c}</option>`).join('');
  });
}

function setLang(l){
  lang = l;
  document.documentElement.lang = l;
  document.documentElement.dir = (l==='he') ? 'rtl' : 'ltr';
  ['he','en','ru','fr'].forEach(x=>document.getElementById('btn-'+x).classList.toggle('on', x===l));
  document.querySelectorAll('[data-i18n]').forEach(el=>{
    const k = el.getAttribute('data-i18n');
    if(T[l][k]!==undefined){ el.innerHTML = T[l][k]; }
  });
  updateCTA();
  refreshExplore();
}

function showStep(){
  // steps map: entry->1, rules->2, form->3, review->4, done->all done
  const step = Math.min(idx+1, 4);
  document.querySelectorAll('#steps .st').forEach(s=>{
    const n = +s.dataset.step;
    s.classList.toggle('active', n===step && idx<4);
    s.classList.toggle('done', n<step || idx===4);
  });
}

function updateCTA(){
  const cta = document.getElementById('cta');
  const action = document.getElementById('action');
  if(idx===4){ action.style.display='none'; return; }
  action.style.display='block';
  let key='ctaStart', sec=false;
  if(idx===0) key='ctaStart';
  else if(idx===1) key='ctaContinue';
  else if(idx===2) key='ctaReview';
  else if(idx===3){ key='ctaSend'; sec=false; }
  cta.textContent = T[lang][key];
  cta.classList.toggle('secondary', idx===3);
  cta.disabled = (idx===1 && rulesRead.size < RULES_TOTAL);
}

function render(){
  document.querySelectorAll('.screen').forEach((s,i)=>s.classList.toggle('active', flow[idx]===s.id));
  document.querySelector('.screenwrap').scrollTop = 0;
  showStep();
  updateCTA();
}

function next(){
  if(idx===1 && rulesRead.size < RULES_TOTAL) return;
  if(idx < flow.length-1){
    idx++;
    if(idx===4){ document.getElementById('code').textContent = genCode(); }
    render();
  }
}

const RULES_TOTAL = 6;
let rulesRead = new Set();
function tapRule(el){
  const n = el.dataset.rule;
  if(rulesRead.has(n)){ rulesRead.delete(n); el.classList.remove('read'); }
  else { rulesRead.add(n); el.classList.add('read'); }
  const c = document.getElementById('ackcount');
  c.textContent = rulesRead.size + '/' + RULES_TOTAL;
  c.classList.toggle('full', rulesRead.size===RULES_TOTAL);
  updateCTA();
}

function setPhone(kind){
  document.getElementById('ph-il').classList.toggle('on', kind==='il');
  document.getElementById('ph-intl').classList.toggle('on', kind==='intl');
  const ph = document.getElementById('phone');
  ph.value = kind==='il' ? '05' : '+1 ';
  ph.focus();
}

function genCode(){
  const n = Math.floor(1000 + Math.random()*8999);
  return 'BGN-' + n;
}

function restart(){
  idx = 0;
  rulesRead.clear();
  document.querySelectorAll('.rule.read').forEach(r=>r.classList.remove('read'));
  const c = document.getElementById('ackcount');
  c.textContent = '0/' + RULES_TOTAL; c.classList.remove('full');
  showScreenId(null); // clear explore if open
  render();
}


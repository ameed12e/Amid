<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
<title>Budget · Fast Check-in — Demo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800&family=Space+Mono:wght@700&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#002E6D;
    --navy-deep:#00194a;
    --navy-soft:#0b3f8f;
    --orange:#F58220;
    --orange-bright:#ff7a00;
    --yellow:#FFC72C;
    --red:#D42F2F;
    --paper:#F4F6FA;
    --card:#ffffff;
    --ink:#152238;
    --muted:#6a7690;
    --line:#e6eaf1;
    --ok:#1e9e6a;
  }
  *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
  html,body{height:100%}
  body{
    font-family:'Rubik',system-ui,sans-serif;
    color:var(--ink);
    background:
      radial-gradient(1200px 600px at 50% -10%, #0b3f8f 0%, transparent 60%),
      linear-gradient(160deg,#00194a 0%, #002E6D 55%, #001233 100%);
    min-height:100dvh;
    display:flex;align-items:center;justify-content:center;
    padding:24px 12px;
  }

  /* ------- device shell ------- */
  .phone{
    position:relative;
    width:100%;
    max-width:412px;
    height:min(860px, calc(100dvh - 40px));
    background:var(--paper);
    border-radius:34px;
    overflow:hidden;
    display:flex;flex-direction:column;
    box-shadow:0 40px 90px -20px rgba(0,10,40,.7), 0 0 0 10px #0a1636, 0 0 0 11px #223a6e;
  }
  @media (max-width:479px){
    body{padding:0}
    .phone{max-width:none;height:100dvh;border-radius:0;box-shadow:none}
  }

  /* ------- top bar ------- */
  .topbar{
    background:var(--navy);
    color:#fff;
    padding:14px 18px 12px;
    display:flex;align-items:center;justify-content:space-between;gap:10px;
    flex:0 0 auto;
  }
  .brand{display:flex;align-items:center;gap:9px;font-weight:800;letter-spacing:.2px;font-size:19px}
  .brand .mark{
    display:inline-flex;align-items:center;justify-content:center;
    width:26px;height:26px;border-radius:7px;background:var(--orange);
    color:var(--navy-deep);font-weight:800;font-size:15px;transform:skewX(-6deg);
  }
  .brand .mark span{transform:skewX(6deg)}
  .brand b{color:#fff}
  .brand i{color:var(--orange);font-style:normal;font-weight:600;font-size:12px;opacity:.95;align-self:flex-end;padding-bottom:2px}

  .lang{
    display:flex;background:rgba(255,255,255,.12);border-radius:999px;padding:3px;font-size:12px;font-weight:600
  }
  .lang button{
    border:0;background:transparent;color:#cdd8ef;padding:6px 9px;border-radius:999px;cursor:pointer;font-family:inherit;font-weight:700;font-size:12px;line-height:1
  }
  .lang button.on{background:#fff;color:var(--navy)}

  .demo-pill{
    background:var(--yellow);color:#3a2a00;font-weight:700;font-size:11px;
    text-align:center;padding:4px 8px;letter-spacing:.3px;
  }

  /* ------- progress ------- */
  .steps{
    display:flex;gap:6px;padding:12px 16px 4px;background:var(--paper);flex:0 0 auto;
  }
  .steps .st{flex:1;display:flex;flex-direction:column;gap:6px;align-items:center;font-size:10.5px;color:var(--muted);font-weight:600}
  .steps .bar{height:4px;width:100%;border-radius:4px;background:var(--line)}
  .steps .st.done .bar{background:var(--orange)}
  .steps .st.active .bar{background:var(--navy)}
  .steps .st.active{color:var(--navy)}

  /* ------- scroll area ------- */
  .screenwrap{flex:1 1 auto;overflow-y:auto;-webkit-overflow-scrolling:touch}
  .screen{display:none;padding:18px 18px 20px;animation:rise .35s ease both}
  .screen.active{display:block}
  @keyframes rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

  .eyebrow{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:var(--orange);
    background:#fff3e6;padding:5px 10px;border-radius:999px;margin-bottom:12px}
  .eyebrow.ok{color:var(--ok);background:#e6f6ee}
  .eyebrow .dot{width:7px;height:7px;border-radius:50%;background:currentColor}
  h1{font-size:24px;line-height:1.15;font-weight:800;letter-spacing:-.2px;margin-bottom:6px}
  .sub{color:var(--muted);font-size:14px;line-height:1.5;margin-bottom:16px}

  /* ------- booking card ------- */
  .booking{
    background:linear-gradient(135deg,var(--navy) 0%, var(--navy-soft) 100%);
    color:#fff;border-radius:18px;padding:18px;position:relative;overflow:hidden;
    box-shadow:0 14px 30px -14px rgba(0,30,90,.6)
  }
  .booking::after{content:"";position:absolute;inset:auto -30px -40px auto;width:150px;height:150px;
    background:radial-gradient(circle,rgba(245,130,32,.35),transparent 70%)}
  .booking .conf{font-family:'Space Mono',monospace;font-size:17px;letter-spacing:1px;color:var(--yellow)}
  .booking .rowset{display:grid;grid-template-columns:1fr 1fr;gap:14px 12px;margin-top:14px;position:relative;z-index:1}
  .booking .k{font-size:11px;color:#a9bde3;font-weight:600;margin-bottom:2px}
  .booking .v{font-size:14.5px;font-weight:600}
  .scanline{display:flex;align-items:center;gap:8px;font-size:12px;color:#bcd0f0;margin-bottom:10px;font-weight:600}
  .scanline svg{filter:drop-shadow(0 0 6px rgba(255,199,44,.5))}

  /* ------- rules ------- */
  .ackhint{display:flex;align-items:center;gap:9px;font-size:12.5px;font-weight:600;color:var(--muted);margin-bottom:12px}
  .ackhint .count{font-weight:800;color:var(--navy);background:#e9eefb;border-radius:999px;padding:2px 9px;font-size:12px;min-width:38px;text-align:center}
  .ackhint .count.full{background:var(--ok);color:#fff}
  .rule{display:flex;align-items:center;gap:12px;width:100%;text-align:start;font-family:inherit;
    padding:13px 14px;border-radius:14px;background:#fff;border:1.5px solid var(--line);margin-bottom:10px;
    cursor:pointer;transition:border-color .15s, background .15s;color:var(--ink)}
  .rule:focus-visible{outline:3px solid rgba(0,46,109,.35);outline-offset:2px}
  .rule .ic{flex:0 0 34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-weight:800;color:#fff;font-size:15px}
  .rule .tx{font-size:13.5px;line-height:1.45;flex:1}
  .rule.i1 .ic{background:var(--navy)}
  .rule.i2 .ic{background:var(--red)}
  .rule.i3 .ic{background:var(--orange)}
  .rule.i4 .ic{background:var(--navy-soft)}
  .rule.i5 .ic{background:var(--ok)}
  .rule.i6 .ic{background:var(--yellow);color:var(--navy-deep)}
  .rule .chk{flex:0 0 26px;height:26px;border-radius:50%;border:2px solid var(--line);
    display:flex;align-items:center;justify-content:center;transition:.15s;background:#fff}
  .rule .chk svg{opacity:0;transform:scale(.4);transition:.18s}
  .rule.read{border-color:var(--ok);background:#f2fbf6}
  .rule.read .chk{background:var(--ok);border-color:var(--ok);transform:scale(1.05)}
  .rule.read .chk svg{opacity:1;transform:none}

  /* ------- form ------- */
  .hint{display:flex;gap:9px;align-items:flex-start;background:#fff8ec;border:1px solid #ffe4b8;
    color:#7a4e00;border-radius:12px;padding:11px 13px;font-size:12.5px;font-weight:500;line-height:1.4;margin-bottom:14px}
  .hint b{color:#7a4e00}
  .field{margin-bottom:13px}
  .field.half{display:inline-block;width:calc(50% - 5px)}
  .field.half + .field.half{margin-inline-start:10px}
  label{display:block;font-size:12px;font-weight:700;color:var(--ink);margin-bottom:5px}
  label .loaded{color:var(--ok);font-weight:600;font-size:10.5px;margin-inline-start:5px}
  input,select{
    width:100%;font-family:inherit;font-size:15px;color:var(--ink);
    padding:12px 13px;border:1.5px solid var(--line);border-radius:11px;background:#fff;
    transition:border-color .15s, box-shadow .15s
  }
  input:focus,select:focus{outline:0;border-color:var(--navy);box-shadow:0 0 0 3px rgba(0,46,109,.12)}
  .seg{display:flex;background:#eef1f7;border-radius:11px;padding:4px;margin-bottom:8px}
  .seg button{flex:1;border:0;background:transparent;font-family:inherit;font-weight:700;font-size:13px;color:var(--muted);
    padding:8px;border-radius:8px;cursor:pointer}
  .seg button.on{background:#fff;color:var(--navy);box-shadow:0 2px 6px rgba(0,20,60,.1)}
  .divider{height:1px;background:var(--line);margin:16px 0 14px}
  .grouplabel{font-size:11px;font-weight:800;letter-spacing:.6px;text-transform:uppercase;color:var(--muted);margin-bottom:10px}

  /* ------- review ------- */
  .rev{background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden}
  .rev .r{display:flex;justify-content:space-between;gap:14px;padding:11px 14px;border-bottom:1px solid var(--line)}
  .rev .r:last-child{border-bottom:0}
  .rev .rk{font-size:12px;color:var(--muted);font-weight:600}
  .rev .rv{font-size:13.5px;font-weight:600;text-align:end}

  /* ------- done / ticket ------- */
  .done-hero{text-align:center;padding-top:6px}
  .check{
    width:78px;height:78px;border-radius:50%;margin:4px auto 14px;
    background:radial-gradient(circle at 30% 25%, #29c07f, #1e9e6a);
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 12px 30px -8px rgba(30,158,106,.6)
  }
  .check svg path{stroke-dasharray:34;stroke-dashoffset:34;animation:draw .5s .15s ease forwards}
  @keyframes draw{to{stroke-dashoffset:0}}
  .ticket{
    position:relative;margin:18px 0 6px;border-radius:18px;color:#fff;
    background:linear-gradient(135deg,var(--navy) 0%, var(--navy-soft) 60%, #0a4aa0 100%);
    padding:22px 20px 24px;box-shadow:0 20px 40px -16px rgba(0,20,80,.7);overflow:hidden
  }
  .ticket::before,.ticket::after{content:"";position:absolute;width:26px;height:26px;border-radius:50%;background:var(--paper);top:50%;transform:translateY(-50%)}
  .ticket::before{inset-inline-start:-13px}
  .ticket::after{inset-inline-end:-13px}
  .ticket .perf{position:absolute;inset-inline:16px;top:50%;border-top:2px dashed rgba(255,255,255,.3)}
  .ticket .cap{font-size:12px;color:#bcd0f0;font-weight:600;letter-spacing:.4px}
  .ticket .code{font-family:'Space Mono',monospace;font-size:42px;letter-spacing:3px;color:var(--yellow);margin:6px 0 2px;font-weight:700}
  .ticket .foot{display:flex;justify-content:space-between;margin-top:26px;font-size:11.5px;color:#bcd0f0}
  .ticket .foot b{color:#fff;display:block;font-size:13px;margin-top:2px}
  .done-note{font-size:11.5px;color:var(--muted);text-align:center;margin-top:14px;line-height:1.5}
  .ghostbtn{display:block;width:100%;margin-top:12px;background:transparent;border:1.5px solid var(--line);
    color:var(--muted);font-family:inherit;font-weight:700;font-size:13.5px;padding:11px;border-radius:12px;cursor:pointer}

  /* ------- explore map ------- */
  .explore-cta{margin-top:16px}
  .mapwrap{position:relative;height:440px;border-radius:18px;overflow:hidden;margin-bottom:14px;
    direction:ltr;border:1px solid var(--line);background:#e9ecdf}
  .mapwrap .mapsvg{position:absolute;inset:0;width:100%;height:100%}
  .mapwrap .sealbl{position:absolute;top:12px;left:9px;font-size:10px;font-weight:700;color:#2b6c86;letter-spacing:.5px;opacity:.85;z-index:1}
  .pin{position:absolute;transform:translate(-50%,-50%);display:flex;align-items:center;gap:7px;
    background:none;border:0;cursor:pointer;font-family:inherit;padding:0;z-index:2}
  .pin.flip{flex-direction:row-reverse}
  .pin .dot{flex:0 0 15px;width:15px;height:15px;border-radius:50%;background:var(--orange);
    border:3px solid #fff;box-shadow:0 2px 6px rgba(0,20,60,.3);transition:.15s}
  .pin .plbl{font-size:11px;font-weight:700;color:var(--ink);background:#fff;padding:3px 8px;
    border-radius:999px;box-shadow:0 1px 5px rgba(0,20,60,.18);white-space:nowrap}
  .pin.on .dot{background:var(--red);transform:scale(1.4)}
  .pin.on .plbl{background:var(--navy);color:#fff}
  .pin:focus-visible{outline:3px solid rgba(0,46,109,.4);outline-offset:3px;border-radius:999px}

  .postcard{border:1px solid var(--line);border-radius:16px;overflow:hidden;background:#fff;
    box-shadow:0 12px 26px -16px rgba(0,20,60,.35);animation:rise .3s ease both}
  .pc-scene{height:152px;position:relative}
  .pc-scene svg{width:100%;height:100%;display:block}
  .pc-tag{position:absolute;top:10px;inset-inline-end:10px;background:rgba(255,255,255,.9);
    color:var(--navy);font-size:10px;font-weight:800;letter-spacing:.4px;padding:3px 8px;border-radius:999px}
  .pc-body{padding:13px 15px 15px}
  .pc-name{font-weight:800;font-size:16.5px;margin-bottom:3px}
  .pc-blurb{color:var(--muted);font-size:13px;line-height:1.45}
  .pc-note{font-size:10.5px;color:var(--muted);text-align:center;margin:10px 2px 0;opacity:.85}

  /* ------- footer action ------- */
  .action{flex:0 0 auto;padding:12px 16px 16px;background:var(--paper);border-top:1px solid var(--line)}
  .cta{
    width:100%;border:0;font-family:inherit;font-weight:800;font-size:16px;color:#fff;
    background:linear-gradient(90deg,var(--orange) 0%, var(--orange-bright) 100%);
    padding:15px;border-radius:14px;cursor:pointer;letter-spacing:.2px;
    box-shadow:0 10px 22px -8px rgba(245,130,32,.7);transition:transform .1s, filter .1s
  }
  .cta:active{transform:translateY(1px) scale(.995)}
  .cta:disabled{background:#c9cfdb;box-shadow:none;cursor:not-allowed;color:#fff}
  .cta.secondary{background:var(--navy);box-shadow:0 10px 22px -10px rgba(0,46,109,.6)}

  @media (prefers-reduced-motion:reduce){
    *{animation:none!important;transition:none!important}
    .check svg path{stroke-dashoffset:0}
  }
</style>
</head>
<body>
<div class="phone" id="app">

  <div class="topbar">
    <div class="brand">
      <span class="mark"><span>B</span></span>
      <b>Budget</b>
    </div>
    <div class="lang">
      <button id="btn-he" class="on" onclick="setLang('he')">עב</button>
      <button id="btn-en" onclick="setLang('en')">EN</button>
      <button id="btn-ru" onclick="setLang('ru')">RU</button>
      <button id="btn-fr" onclick="setLang('fr')">FR</button>
    </div>
  </div>
  <div class="demo-pill" data-i18n="demoPill">תצוגת הדגמה · לא מחובר למערכת אמיתית</div>

  <div class="steps" id="steps">
    <div class="st" data-step="1"><div class="bar"></div><span data-i18n="step1">הזמנה</span></div>
    <div class="st" data-step="2"><div class="bar"></div><span data-i18n="step2">כללים</span></div>
    <div class="st" data-step="3"><div class="bar"></div><span data-i18n="step3">פרטים</span></div>
    <div class="st" data-step="4"><div class="bar"></div><span data-i18n="step4">אישור</span></div>
  </div>

  <div class="screenwrap">

    <!-- 1. ENTRY -->
    <section class="screen active" id="s-entry">
      <span class="eyebrow ok"><span class="dot"></span><span data-i18n="scanTag">נסרק בהצלחה</span></span>
      <h1 data-i18n="entryTitle">ההזמנה שלך נטענה</h1>
      <p class="sub" data-i18n="entrySub">השלימו צ'ק-אין בטלפון עוד לפני שתגיעו לדלפק, וקבלו מספר אישור להצגה לנציג.</p>

      <div class="booking">
        <div class="scanline">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M3 7V4a1 1 0 0 1 1-1h3M17 3h3a1 1 0 0 1 1 1v3M21 17v3a1 1 0 0 1-1 1h-3M7 21H4a1 1 0 0 1-1-1v-3" stroke="#FFC72C" stroke-width="2" stroke-linecap="round"/><path d="M3 12h18" stroke="#FFC72C" stroke-width="2" stroke-linecap="round"/></svg>
          <span data-i18n="scanFrom">מתוך אישור ההזמנה שלך</span>
        </div>
        <div class="conf">BUD-IL-7739204</div>
        <div class="rowset">
          <div><div class="k" data-i18n="bkVehicle">רכב</div><div class="v">Group F</div></div>
          <div><div class="k" data-i18n="bkLoc">מיקום</div><div class="v" data-i18n="bkLocVal">נתב"ג (TLV)</div></div>
          <div><div class="k" data-i18n="bkPick">איסוף</div><div class="v">02 Aug · 14:30</div></div>
          <div><div class="k" data-i18n="bkDrop">החזרה</div><div class="v">06 Aug · 11:00</div></div>
        </div>
      </div>
    </section>

    <!-- 2. RULES -->
    <section class="screen" id="s-rules">
      <span class="eyebrow"><span class="dot"></span><span data-i18n="rulesTag">חשוב לדעת</span></span>
      <h1 data-i18n="rulesTitle">לפני שממשיכים</h1>
      <p class="sub" data-i18n="rulesSub">חמישה דברים שיעזרו לחוזה שלך להיפתח מהר בדלפק.</p>

      <div class="ackhint">
        <span class="count" id="ackcount">0/6</span>
        <span data-i18n="ackHint">הקישו על כל כלל כדי לאשר שקראתם אותו.</span>
      </div>

      <button class="rule i1" data-rule="1" onclick="tapRule(this)"><div class="ic">1</div><div class="tx" data-i18n="rule1">יש להביא דרכון, רישיון נהיגה וטופס ביקורת גבולות. היעדר הטופס עלול להוסיף מס.</div><div class="chk"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12l4.5 4.5L19 7" stroke="#fff" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div></button>
      <button class="rule i2" data-rule="2" onclick="tapRule(this)"><div class="ic">2</div><div class="tx" data-i18n="rule2">לקוחות מארה"ב שמוותרים על ביטוח דרך כרטיס אשראי צריכים מכתב רשמי מחברת האשראי — אחרת חל ביטוח הבסיס של Budget.</div><div class="chk"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12l4.5 4.5L19 7" stroke="#fff" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div></button>
      <button class="rule i3" data-rule="3" onclick="tapRule(this)"><div class="ic">3</div><div class="tx" data-i18n="rule3">אזרחי ישראל משלמים מע"מ, בין אם הם גרים בארץ או בחו"ל.</div><div class="chk"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12l4.5 4.5L19 7" stroke="#fff" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div></button>
      <button class="rule i4" data-rule="4" onclick="tapRule(this)"><div class="ic">4</div><div class="tx" data-i18n="rule4">הזמנות שבוצעו באתר Budget לא-ישראלי לרוב אינן כוללות מע"מ.</div><div class="chk"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12l4.5 4.5L19 7" stroke="#fff" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div></button>
      <button class="rule i5" data-rule="5" onclick="tapRule(this)"><div class="ic">5</div><div class="tx" data-i18n="rule5">הנציג בודק את ההזמנה ומעדכן על כל שינוי במחיר לעומת המחיר באתר.</div><div class="chk"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12l4.5 4.5L19 7" stroke="#fff" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div></button>
      <button class="rule i6" data-rule="6" onclick="tapRule(this)"><div class="ic">6</div><div class="tx" data-i18n="rule6">ההזמנה מבטיחה קבוצת רכב (קטגוריה), לא דגם מסוים. החברה מחויבת לספק רכב מתוך הקבוצה, לפי בקשה.</div><div class="chk"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12l4.5 4.5L19 7" stroke="#fff" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div></button>
    </section>

    <!-- 3. FORM -->
    <section class="screen" id="s-form">
      <span class="eyebrow"><span class="dot"></span><span data-i18n="formTag">פרטי הלקוח</span></span>
      <h1 data-i18n="formTitle">הפרטים שלך</h1>
      <div class="hint">
        <span>✍️</span>
        <span data-i18n="formHint"><b>כתבו באנגלית ובאותיות גדולות (CAPITAL).</b> כך הפרטים נקלטים במערכת ללא טעויות.</span>

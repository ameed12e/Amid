let currentPlace = 0;

function buildPins(){
  const wrap = document.getElementById('pins');
  wrap.innerHTML = PLACES.map((p,i)=>{
    const short = p.name[lang].split(' — ')[0];
    const flip = p.x >= 50 ? ' flip' : '';
    return `<button class="pin${i===currentPlace?' on':''}${flip}" style="left:${p.x}%;top:${p.y}%" onclick="selectPlace(${i})">
      <span class="dot"></span><span class="plbl">${short}</span></button>`;
  }).join('');
}

function renderPostcard(){
  const p = PLACES[currentPlace];
  const g = `linear-gradient(135deg,${p.grad[0]},${p.grad[1]})`;
  document.getElementById('postcard').innerHTML =
    `<div class="pc-scene" style="background:${g}">${motifSVG(p.motif)}
       <span class="pc-tag">${T[lang].expTag}</span></div>
     <div class="pc-body"><div class="pc-name">${p.name[lang]}</div>
       <div class="pc-blurb">${p.blurb[lang]}</div></div>`;
}

function selectPlace(i){
  currentPlace = i;
  document.querySelectorAll('.pin').forEach((el,k)=>el.classList.toggle('on', k===i));
  renderPostcard();
}

function showScreenId(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.toggle('active', id!==null && s.id===id));
  if(id){ document.querySelector('.screenwrap').scrollTop = 0; }
}
function showExplore(){ buildPins(); renderPostcard(); showScreenId('s-explore'); }
function backToDone(){ showScreenId('s-done'); }
function refreshExplore(){
  if(document.getElementById('s-explore').classList.contains('active')){ buildPins(); renderPostcard(); }
}

buildCountries();
setLang('he');
render();
</script>
